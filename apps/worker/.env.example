# The worker needs the same database, storage and queue as the API (see apps/api/.env.example).
SQS_QUEUE_URL=http://localhost:9324/000000000000/exam-generator-jobs
SQS_ENDPOINT_URL=http://localhost:9324

# Question generation. Create a dedicated key with a spend limit; never commit it.
# Without it the worker still processes PDFs, but generation jobs fail with a clear message.
ANTHROPIC_API_KEY=
# LLM_GENERATION_MODEL=claude-sonnet-5-5
# LLM_VALIDATION_MODEL=claude-sonnet-5-5

# PDF limits
# PDF_MAX_PAGES=400

# DATABASE_URL=postgresql+psycopg://learn:learn@localhost:5432/learn_assistant
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=../../.data/documents
# EMBEDDING_CACHE_DIR=../../.cache/fastembed

# Logging: JSON lines by default; use text for readable local logs.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
