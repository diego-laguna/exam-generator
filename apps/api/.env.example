# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Background work (PDF processing, question generation) goes through a queue to the worker.
# Locally this is the ElasticMQ container from compose.yaml (`just db-up`).
SQS_QUEUE_URL=http://localhost:9324/000000000000/exam-generator-jobs
SQS_ENDPOINT_URL=http://localhost:9324
# On AWS leave SQS_ENDPOINT_URL unset; Terraform sets SQS_QUEUE_URL and SQS_REGION.

# Defaults match compose.yaml; override if needed.
# DATABASE_URL=postgresql+psycopg://learn:learn@localhost:5432/learn_assistant
# On AWS the URL is built from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD instead.

# Uploaded PDFs: a local folder in development (shared with the worker), S3 on AWS.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=../../.data/documents
# STORAGE_BACKEND=s3
# S3_BUCKET=
