# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Question generation. Create a dedicated key with a spend limit; never commit it.
# Without it the API runs, but POST /api/v1/generations returns 503 LLM_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
# LLM_GENERATION_MODEL=claude-sonnet-5-5
# LLM_VALIDATION_MODEL=claude-sonnet-5-5

# Defaults match compose.yaml; override if needed.
# DATABASE_URL=postgresql+psycopg://learn:learn@localhost:5432/learn_assistant
# On AWS the URL is built from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD instead.

# Uploaded PDFs: a local folder in development, S3 on AWS.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=.data/documents
# STORAGE_BACKEND=s3
# S3_BUCKET=
