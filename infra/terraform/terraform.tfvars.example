region = "us-east-1"
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# protect_data    = false   # allow `terraform destroy` for a throwaway POC
# desired_count        = 1  # after the API image is pushed
# worker_desired_count = 1  # after the worker image is pushed and the Anthropic key is set
# web_base_url         = "https://exams.example.com"  # join links for exam sessions point here
# trusted_proxy_hops   = 1  # proxies in front of the API (ALB = 1; +1 if you add CloudFront)
# alert_email          = "you@example.com"  # queue alarms by email (confirm the AWS link)
